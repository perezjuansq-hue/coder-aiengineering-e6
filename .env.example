# Pinecone: API key del proyecto (app.pinecone.io > API Keys) y nombre del índice (el mismo de la PE4)
PINECONE_API_KEY=
INDEX_NAME=normativa-bcra

# OpenAI: obligatoria (embeddings text-embedding-3-small del Investigador, y chat si LLM_PROVIDER=openai)
OPENAI_API_KEY=
# Anthropic: solo si LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Proveedor del LLM (supervisor, especialistas y síntesis): openai o anthropic
LLM_PROVIDER=openai

# Modelos: opcional. Si se deja vacío se usa el modelo por defecto (openai: gpt-6-luna, anthropic: claude-haiku-4-5-20251001)
OPENAI_MODEL=
ANTHROPIC_MODEL=
